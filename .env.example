APP_ENV=development
DATABASE_URL=sqlite:///./data/v2_app.db
UPLOAD_DIR=./uploads
YOLO_MODEL=./models/best.pt
FRAME_STRIDE=5
CONFIDENCE_THRESHOLD=0.35
EXPECTED_TRAFFIC_DIRECTION=left_to_right
RESTRICTED_AREA_POLYGON=
CONGESTION_VEHICLE_THRESHOLD=12
STOPPED_MIN_SECONDS=3.0
STOPPED_MAX_MOVEMENT_PX=18.0
KEYFRAME_INTERVAL_SECONDS=2.0
KEYFRAME_TARGET_FPS=2.0
MAX_KEYFRAMES_PER_VIDEO=120
KEYFRAME_IMAGE_QUALITY=85
SEMANTIC_MODEL=local-semantic-v1
SEMANTIC_MODEL_NAME_OR_PATH=openai/clip-vit-base-patch32
SEMANTIC_MODEL_VERSION=transformers-4.45.2
SEMANTIC_MODEL_CACHE_DIR=./data/huggingface
SEMANTIC_DEVICE=auto
SEMANTIC_BATCH_SIZE=8
SEMANTIC_WEIGHT=0.85
OBJECT_WEIGHT=0.10
ATTRIBUTE_WEIGHT=0.05
RELATION_WEIGHT=0.10
KIS_OBJECT_CROP_SEMANTIC_WEIGHT=0.03
KIS_COLOR_CONFIDENCE_THRESHOLD=0.22
AUTO_ANALYZE_ON_UPLOAD=false
ENABLE_FAISS=false
ENABLE_OPENAI=false
ENABLE_WHISPER=false
WHISPER_MODEL=base
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false
GEMINI_TIMEOUT_SECONDS=15
GEMINI_CACHE_TTL_SECONDS=300
GEMINI_MAX_QUERY_LENGTH=1000
GEMINI_VISION_ENABLED=false
LOCATE_ANYTHING_ENABLED=false
KIS_GROUNDING_RERANK_ENABLED=false
YOLO_WORLD_ENABLED=true
YOLO_WORLD_MODEL=yolov8s-worldv2.pt
YOLO_WORLD_CONF=0.25
YOLO_WORLD_SAMPLE_FPS=2
YOLO_WORLD_CACHE=true
YOLO_WORLD_CACHE_DIR=./data/yolo_world_cache
YOLO_WORLD_CLIP_CACHE_HOME=./data
YOLO_WORLD_ATTRIBUTE_PROMPTS=false
YOLO_WORLD_FALLBACK_WHEN_PRIMARY_EMPTY=false
YOLO_WORLD_MERGE_GAP_SECONDS=1.5
